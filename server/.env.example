# Porta da API
PORT=3333

# Endereço do front-end, usado para montar o link de acompanhamento enviado ao cliente.
# Em desenvolvimento: http://localhost:5173 • Em produção: a URL pública do sistema
APP_URL=http://localhost:5173

# Dados da oficina exibidos nas mensagens e na página do cliente
NOME_OFICINA=Oficina Mecânica Exemplo
TELEFONE_OFICINA=42999990000

# API FIPE (Parallelum v2). O token é opcional e aumenta o limite diário de consultas.
FIPE_API_URL=https://fipe.parallelum.com.br/api/v2
FIPE_TOKEN=
# Use 1 para apresentar sem internet (respostas simuladas no formato real da API)
FIPE_MOCK=0
