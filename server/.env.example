# ------------------------------------------------------------------ Geral
PORT=3333
# Endereço do site, usado nos links enviados ao cliente.
# Desenvolvimento: http://localhost:5173 · Produção: a URL pública (ex.: https://oficinastatus.onrender.com)
APP_URL=http://localhost:5173
# Segredo dos logins (JWT). Se ficar vazio, o sistema gera um e guarda em server/data/.
JWT_SECRET=

NOME_OFICINA=Oficina Mecânica Exemplo
TELEFONE_OFICINA=42999990000
ENDERECO_OFICINA=Rua Exemplo, 123 - União da Vitória/PR

# ------------------------------------------------------------------ E-mail (SMTP)
# Gmail: ative a verificação em 2 etapas e crie uma "senha de app" em myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ------------------------------------------------------------------ WhatsApp (API oficial da Meta)
# Sem estas variáveis, as mensagens ficam prontas para envio com um clique pelo WhatsApp Web.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Mensagens iniciadas pela empresa exigem um modelo aprovado na Meta (veja o README).
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_IDIOMA=pt_BR

# ------------------------------------------------------------------ Consulta por placa (PlacaFipe, plano pago)
PLACA_API_URL=https://api.placafipe.com.br
PLACA_API_TOKEN=

# ------------------------------------------------------------------ API FIPE (Parallelum, gratuita)
FIPE_API_URL=https://fipe.parallelum.com.br/api/v2
# Opcional: aumenta o limite diário de consultas (fipe.online)
FIPE_TOKEN=
