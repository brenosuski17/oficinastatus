# Variáveis de PRODUÇÃO (VM do Azure com docker-compose.prod.yml).
# O deploy/instalar-vm.sh copia este arquivo para server/.env, gera os segredos e deixa só o dono ler (chmod 600).
# Nunca commite o server/.env. Depois de preencher, suba com:
#   docker compose --env-file server/.env -f docker-compose.prod.yml up -d --build

# ------------------------------------------------------------------ Endereço
# Domínio com registro A apontando para o IP público da VM, sem https:// e sem barra no fim.
# O Caddy usa este nome para pedir o certificado do Let's Encrypt.
DOMINIO=seu-dominio.com.br
# Endereço dos links enviados ao cliente (e-mail e Telegram). O docker-compose.prod.yml já monta
# https://DOMINIO e passa por cima deste valor; mantenha os dois iguais para não confundir.
APP_URL=https://seu-dominio.com.br

# ------------------------------------------------------------------ Banco (Azure Database for PostgreSQL Flexible Server)
# Portal → servidor → Overview → Server name. Banco "oficina", criado em Databases.
# sslmode=require é obrigatório no Azure. Caracteres especiais da senha vão codificados (@ → %40, : → %3A, / → %2F).
DATABASE_URL=postgresql://USUARIO:SENHA@NOME-DO-SERVIDOR.postgres.database.azure.com:5432/oficina?sslmode=require

# ------------------------------------------------------------------ Segurança
# Segredo dos logins (JWT). O instalar-vm.sh gera um valor aleatório. Trocar este valor desloga todo mundo.
JWT_SECRET=

# ------------------------------------------------------------------ Oficina (aparece nas mensagens e no portal)
NOME_OFICINA=Oficina Mecânica Exemplo
TELEFONE_OFICINA=42999990000
ENDERECO_OFICINA=Rua Exemplo, 123 - União da Vitória/PR

# ------------------------------------------------------------------ Telegram (bot criado no @BotFather)
# Token que o @BotFather entrega no /newbot.
TELEGRAM_TOKEN=
# Nome do bot, sem @ (ex.: OficinaStatusBot). Vai no link https://t.me/NOME?start=codigo
TELEGRAM_BOT_USERNAME=
# Segredo que o Telegram devolve em cada chamada ao webhook (A-Z a-z 0-9 _ -). O instalar-vm.sh gera um.
TELEGRAM_WEBHOOK_SECRET=
# Depois de subir, registre o webhook no domínio, sem túnel:
#   docker compose --env-file server/.env -f docker-compose.prod.yml exec app node scripts/webhook.js --url https://DOMINIO

# ------------------------------------------------------------------ E-mail (SMTP, opcional)
# Sem SMTP, os e-mails ficam registrados com o motivo da falha. Gmail: senha de app em myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ------------------------------------------------------------------ Consulta por placa (PlacaFipe, opcional e pago)
PLACA_API_URL=https://api.placafipe.com.br
PLACA_API_TOKEN=

# ------------------------------------------------------------------ API FIPE (Parallelum, gratuita)
FIPE_API_URL=https://fipe.parallelum.com.br/api/v2
# Opcional: aumenta o limite diário de consultas (fipe.online)
FIPE_TOKEN=
